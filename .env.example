# Environment Configuration for Apex Retail Intelligence OS
# Copy this file to .env and modify values as needed

# Database
DATABASE_URL=postgresql://apex:apex@db:5432/apex_retail

# File Storage
VIDEO_DIR=/data/videos
UPLOAD_DIR=/data/uploads

# Computer Vision
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.3
FPS_SKIP=5

# Staff Detection
# Options: clip, color
STAFF_DETECTION_METHOD=color
UNIFORM_COLOR_HSV_LOWER=100,50,50
UNIFORM_COLOR_HSV_UPPER=130,255,255

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*

# PostgreSQL (used by docker-compose)
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex
POSTGRES_DB=apex_retail
